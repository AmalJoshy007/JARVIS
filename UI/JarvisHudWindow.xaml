<Window x:Class="JarvisBot.UI.JarvisHudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="J.A.R.V.I.S. Command Center"
        Height="680" Width="460"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <!-- ScrollBar Minimalist Theme -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track Name="PART_Track" IsDirectionReversed="true">
                            <Track.Thumb>
                                <Thumb Background="#00F0FF33"/>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Quick Action Button Style -->
        <Style x:Key="QuickChipStyle" TargetType="Button">
            <Setter Property="Background" Value="#152136"/>
            <Setter Property="Foreground" Value="#00F0FF"/>
            <Setter Property="BorderBrush" Value="#00F0FF44"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,8,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#00F0FF22"/>
                                <Setter Property="BorderBrush" Value="#00F0FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#00F0FF44"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Header Minimize Button Style -->
        <Style x:Key="HeaderMinButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8FA3BF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1F2D47"/>
                                <Setter Property="Foreground" Value="#00F0FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Header Close Button Style -->
        <Style x:Key="HeaderCloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FF5C5C"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF3B30"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Main Glassmorphic Container -->
    <Border CornerRadius="18"
            Background="#E60A0F1D"
            BorderBrush="#00F0FF66"
            BorderThickness="1.5"
            Margin="10">
        <Border.Effect>
            <DropShadowEffect Color="#00F0FF" BlurRadius="25" ShadowDepth="0" Opacity="0.55"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="Auto"/> <!-- Audio Visualizer -->
                <RowDefinition Height="Auto"/> <!-- Live Hypothesis Status -->
                <RowDefinition Height="*"/>    <!-- Transcript Stream -->
                <RowDefinition Height="Auto"/> <!-- Quick Action Chips -->
                <RowDefinition Height="Auto"/> <!-- Input & Controls -->
            </Grid.RowDefinitions>

            <!-- 1. Header -->
            <Border Grid.Row="0" Background="#141D30" CornerRadius="16,16,0,0" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Draggable Header Region: Columns 0 & 1 -->
                    <Grid Grid.Column="0" Grid.ColumnSpan="2" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Mini Arc Reactor Icon -->
                        <Grid Grid.Column="0" Width="32" Height="32" Margin="0,0,12,0" IsHitTestVisible="False">
                            <Ellipse Stroke="#00F0FF" StrokeThickness="1.5"/>
                            <Ellipse Width="18" Height="18" Fill="#00F0FF" Opacity="0.8">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#00F0FF" BlurRadius="8" ShadowDepth="0"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Grid>

                        <!-- Title & Subtitle -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" IsHitTestVisible="False">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="J.A.R.V.I.S." FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                                <!-- Status Badge -->
                                <Border x:Name="StatusBadge" Margin="10,0,0,0" Background="#00F0FF22" BorderBrush="#00F0FF" BorderThickness="1" CornerRadius="8" Padding="6,1">
                                    <TextBlock x:Name="StatusText" Text="ONLINE" FontSize="10" FontWeight="Bold" Foreground="#00F0FF"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="OFFLINE AUTONOMOUS DESKTOP INTELLIGENCE" FontSize="9.5" Foreground="#00F0FF99" Margin="0,2,0,0" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Grid>

                    <!-- Window Buttons (Independent Hit Test) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Minimize to Floating Orb -->
                        <Button Style="{StaticResource HeaderMinButtonStyle}" Content="—" Click="MinimizeToOrb_Click" ToolTip="Minimize to Floating Orb" Margin="0,0,6,0"/>
                        <!-- Close / Shutdown -->
                        <Button Style="{StaticResource HeaderCloseButtonStyle}" Content="✕" Click="CloseApp_Click" ToolTip="Exit Application"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. Neon Audio Equalizer Bars -->
            <Border Grid.Row="1" Background="#0C1220" Padding="16,8" BorderBrush="#00F0FF22" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="MIC INPUT" FontSize="10" FontWeight="Bold" Foreground="#8B949E" VerticalAlignment="Center" Margin="0,0,12,0"/>

                    <!-- Equalizer Canvas with 16 bars -->
                    <StackPanel x:Name="EqualizerPanel" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- Bars dynamically scaled in code-behind -->
                    </StackPanel>

                    <TextBlock x:Name="AudioPercentText" Grid.Column="2" Text="0%" FontSize="10" FontWeight="Bold" Foreground="#00F0FF" VerticalAlignment="Center" MinWidth="48" TextAlignment="Right"/>
                </Grid>
            </Border>

            <!-- 3. Live Speech Transcribing Banner -->
            <Border Grid.Row="2" x:Name="HypothesisBanner" Background="#0A1E33" Padding="14,6" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🎙️ Listening:" FontSize="11" FontWeight="Bold" Foreground="#00F0FF" Margin="0,0,8,0"/>
                    <TextBlock x:Name="HypothesisText" Text="detecting speech..." FontSize="11" Foreground="#FFFFFF" FontStyle="Italic"/>
                </StackPanel>
            </Border>

            <!-- 4. Transcript Feed -->
            <ScrollViewer Grid.Row="3" x:Name="TranscriptScrollViewer" Padding="16,12" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="MessagesPanel">
                    <!-- Initial Welcome Message -->
                    <Border Background="#131D2E" CornerRadius="12" Padding="14,10" Margin="0,0,40,10" BorderBrush="#00F0FF33" BorderThickness="1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="⚡ J.A.R.V.I.S." FontSize="11" FontWeight="Bold" Foreground="#00F0FF"/>
                                <TextBlock Text="Core System" FontSize="10" Foreground="#8B949E" Margin="6,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="All systems functional. Ready for instructions. Speak into your microphone or type below." TextWrapping="Wrap" Foreground="#E6EDF3" FontSize="13" LineHeight="18"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 5. Quick Action Chips -->
            <Border Grid.Row="4" Padding="16,6,16,6" Background="#0D1322">
                <WrapPanel>
                    <Button Style="{StaticResource QuickChipStyle}" Content="📝 Notepad" Click="QuickChip_Click" Tag="open notepad"/>
                    <Button Style="{StaticResource QuickChipStyle}" Content="✍️ Type Note" Click="QuickChip_Click" Tag="open notepad and type task 1 completed"/>
                    <Button Style="{StaticResource QuickChipStyle}" Content="🔢 Calculator" Click="QuickChip_Click" Tag="open calculator"/>
                    <Button Style="{StaticResource QuickChipStyle}" Content="🌐 Search Web" Click="QuickChip_Click" Tag="search the web for artificial intelligence"/>
                    <Button Style="{StaticResource QuickChipStyle}" Content="📺 YouTube" Click="QuickChip_Click" Tag="open youtube"/>
                    <Button Style="{StaticResource QuickChipStyle}" Content="⏰ Current Time" Click="QuickChip_Click" Tag="what time is it"/>
                    <Button Style="{StaticResource QuickChipStyle}" Content="🔒 Lock Screen" Click="QuickChip_Click" Tag="lock workstation"/>
                </WrapPanel>
            </Border>

            <!-- 6. Input Bar -->
            <Border Grid.Row="5" Background="#141C2E" CornerRadius="0,0,16,16" Padding="14,10" BorderBrush="#00F0FF33" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Mic Toggle Button -->
                    <Button x:Name="MicButton" Grid.Column="0" Width="36" Height="36" Margin="0,0,10,0" Background="#1D2A42" BorderBrush="#00F0FF" BorderThickness="1.5" Cursor="Hand" Click="MicButton_Click" ToolTip="Microphone Active (Click to Mute)">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="18">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock x:Name="MicIconText" Text="🎙️" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>

                    <!-- Input Box -->
                    <TextBox x:Name="CommandInput" Grid.Column="1" Height="36" Background="#090E1A" Foreground="#FFFFFF" BorderBrush="#00F0FF44" BorderThickness="1" Padding="12,7" FontSize="13" VerticalContentAlignment="Center" KeyDown="CommandInput_KeyDown">
                        <TextBox.Resources>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="CornerRadius" Value="10"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>

                    <!-- Send Button -->
                    <Button Grid.Column="2" Width="40" Height="36" Margin="10,0,0,0" Background="#00F0FF" Foreground="#040812" BorderThickness="0" Cursor="Hand" Click="SendButton_Click" ToolTip="Execute Command">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                    <TextBlock Text="➤" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#050C1A"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
