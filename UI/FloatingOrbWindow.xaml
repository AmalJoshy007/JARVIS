<Window x:Class="JarvisBot.UI.FloatingOrbWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="J.A.R.V.I.S. Floating Orb"
        Height="100" Width="100"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Cursor="Hand"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseRightButtonUp="Window_MouseRightButtonUp"
        ToolTip="J.A.R.V.I.S. (Click to open HUD | Drag to reposition)">
    
    <Window.Resources>
        <!-- Rotating Animation for Outer Ring -->
        <Storyboard x:Key="RotateOuterRing" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="OuterRingRotation"
                             Storyboard.TargetProperty="Angle"
                             From="0" To="360" Duration="0:0:8" />
        </Storyboard>

        <!-- Counter-rotating Animation for Inner Ring -->
        <Storyboard x:Key="RotateInnerRing" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="InnerRingRotation"
                             Storyboard.TargetProperty="Angle"
                             From="360" To="0" Duration="0:0:5" />
        </Storyboard>

        <!-- Core Glow Pulse Animation -->
        <Storyboard x:Key="PulseCoreGlow" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="CoreGlow"
                             Storyboard.TargetProperty="Opacity"
                             From="0.5" To="1.0" Duration="0:0:1.8" />
            <DoubleAnimation Storyboard.TargetName="CoreScale"
                             Storyboard.TargetProperty="ScaleX"
                             From="0.95" To="1.05" Duration="0:0:1.8" />
            <DoubleAnimation Storyboard.TargetName="CoreScale"
                             Storyboard.TargetProperty="ScaleY"
                             From="0.95" To="1.05" Duration="0:0:1.8" />
        </Storyboard>
    </Window.Resources>

    <Grid>
        <!-- Audio Reactive Outer Pulse Ring -->
        <Ellipse x:Name="AudioPulseRing" Width="92" Height="92" Opacity="0.3"
                 Stroke="#00F0FF" StrokeThickness="1.5">
            <Ellipse.Effect>
                <DropShadowEffect Color="#00F0FF" BlurRadius="20" ShadowDepth="0" Opacity="0.8"/>
            </Ellipse.Effect>
            <Ellipse.RenderTransform>
                <ScaleTransform x:Name="PulseScale" CenterX="46" CenterY="46" ScaleX="1" ScaleY="1" />
            </Ellipse.RenderTransform>
        </Ellipse>

        <!-- Outer Rotating Dashed Ring -->
        <Ellipse Width="82" Height="82"
                 Stroke="#00F0FF" StrokeThickness="2"
                 StrokeDashArray="4 3" Opacity="0.85">
            <Ellipse.Effect>
                <DropShadowEffect Color="#00F0FF" BlurRadius="12" ShadowDepth="0" Opacity="0.9"/>
            </Ellipse.Effect>
            <Ellipse.RenderTransform>
                <RotateTransform x:Name="OuterRingRotation" CenterX="41" CenterY="41"/>
            </Ellipse.RenderTransform>
        </Ellipse>

        <!-- Middle Counter-Rotating Ring -->
        <Ellipse Width="66" Height="66"
                 Stroke="#0077FE" StrokeThickness="1.5"
                 StrokeDashArray="8 4 2 4" Opacity="0.9">
            <Ellipse.Effect>
                <DropShadowEffect Color="#0077FE" BlurRadius="8" ShadowDepth="0" Opacity="0.8"/>
            </Ellipse.Effect>
            <Ellipse.RenderTransform>
                <RotateTransform x:Name="InnerRingRotation" CenterX="33" CenterY="33"/>
            </Ellipse.RenderTransform>
        </Ellipse>

        <!-- Arc Reactor Base Core -->
        <Ellipse Width="50" Height="50">
            <Ellipse.Fill>
                <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                    <GradientStop Color="#00F0FF" Offset="0.0"/>
                    <GradientStop Color="#0066FF" Offset="0.45"/>
                    <GradientStop Color="#091322" Offset="0.85"/>
                    <GradientStop Color="#040812" Offset="1.0"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.Effect>
                <DropShadowEffect x:Name="CoreGlow" Color="#00F0FF" BlurRadius="16" ShadowDepth="0" Opacity="0.9"/>
            </Ellipse.Effect>
            <Ellipse.RenderTransform>
                <ScaleTransform x:Name="CoreScale" CenterX="25" CenterY="25" ScaleX="1" ScaleY="1"/>
            </Ellipse.RenderTransform>
        </Ellipse>

        <!-- Inner Triangle / Power Core Symbol -->
        <Polygon Points="50,34 60,54 40,54"
                 Fill="#CCFFFFFF" Stroke="#00F0FF" StrokeThickness="1"
                 Opacity="0.9">
            <Polygon.Effect>
                <DropShadowEffect Color="#00F0FF" BlurRadius="6" ShadowDepth="0"/>
            </Polygon.Effect>
        </Polygon>

        <!-- Status Dot in Center -->
        <Ellipse Width="6" Height="6" Fill="#FFFFFF">
            <Ellipse.Effect>
                <DropShadowEffect Color="#FFFFFF" BlurRadius="8" ShadowDepth="0"/>
            </Ellipse.Effect>
        </Ellipse>
    </Grid>
</Window>
