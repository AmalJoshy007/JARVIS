<Application x:Class="JarvisBot.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <SolidColorBrush x:Key="CyanNeonBrush" Color="#00F0FF" />
        <SolidColorBrush x:Key="BlueNeonBrush" Color="#0077FE" />
        <SolidColorBrush x:Key="DarkBgBrush" Color="#0D1117" />
        <SolidColorBrush x:Key="CardBgBrush" Color="#161B22" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E6EDF3" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#8B949E" />
    </Application.Resources>
</Application>
